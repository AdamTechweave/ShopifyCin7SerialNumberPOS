# --- Cin7 Core (per client) -------------------------------------------------
# Create an application key at inventory.dearsystems.com/ExternalAPI
CIN7_ACCOUNT_ID=
CIN7_APPLICATION_KEY=

# Product tag marking a serial-tracked product (default: serialized).
# NOTE: if you change this, also edit the tag literal in
# extensions/serial-validation/src/cart_validations_generate_run.graphql
SERIAL_TAG=serialized

# Shopify location ID -> Cin7 Core location name. Must be a JSON object of
# strings; the app refuses to start otherwise. Location IDs come from the
# Shopify admin URL under Settings -> Locations.
CIN7_LOCATION_MAP={"12345678":"Main Warehouse"}

# --- Database (Supabase Postgres) -------------------------------------------
# Pooled connection — Supabase "Transaction" pooler, port 6543. Required on
# Vercel: every serverless invocation opens its own connection.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection — port 5432. Used only for `prisma migrate deploy`, which
# cannot run through pgbouncer.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Shopify app ------------------------------------------------------------
# From the app's Dev Dashboard page. SHOPIFY_APP_URL must match application_url
# in shopify.app.toml (the POS extension resolves its relative API calls
# against it — a mismatch makes every serial lookup fail).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=read_products,write_validations
